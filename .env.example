# Copy this file to ".env" and fill in the values. Keep it up to date when
# adding new variables — this file is committed, so never put real secrets here.

# ── Supabase ────────────────────────────────────────────────────────────────
# Project settings → API. The service-role key bypasses RLS — server only,
# never expose it client-side.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ── Database (Prisma → Supabase Postgres) ───────────────────────────────────
# DATABASE_URL: pooled connection (runtime). DIRECT_URL: direct connection
# (migrations).
DATABASE_URL="postgresql://postgres:password@db.<project-ref>.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:password@db.<project-ref>.supabase.co:5432/postgres"

# ── App ─────────────────────────────────────────────────────────────────────
# Absolute origin of the deployed app (used in admin invite emails, etc.)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Validated by src/env.js (legacy of the t3 scaffold — required at build time
# even though next-auth itself is unused).
AUTH_SECRET=""

# ── Integrations ────────────────────────────────────────────────────────────
# Groq API key for /api/career-paths generation.
GROQ_API_KEY=""
